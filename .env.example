# Exemplo de variáveis de ambiente para Railway
# Copie este arquivo para .env e configure com seus valores

# DATABASE
DB_URL=postgresql://user:password@host:5432/pronnect
DB_USER=postgres
DB_PASS=sua_senha_aqui

# JWT
JWT_SECRET=seu_base64_secret_aqui_use_openssl_rand_base64_32
JWT_EXPIRATION=86400000

# CORS
CORS_ORIGIN=https://seu-frontend.com

# SERVER
PORT=8080

# PAYMENT
PAYMENT_MOCK_ENABLED=false
PAYMENT_AUTO_APPROVE_SECONDS=10

# SPRING PROFILE
SPRING_PROFILES_ACTIVE=prod
